# ---- Database (Supabase: project aangan-call-desk, ref cobiycxqaycdcuylttjo, ap-south-1) ----
# Dashboard > Connect > Transaction pooler (port 6543). Free projects pause after ~7 days idle;
# the cron in /api/cron/tick queries the DB so it stays active, and alerts on Telegram if it can't.
DATABASE_URL=

# ---- Vaani ----
# app.vaanivoice.ai > Settings > API Keys
VAANI_API_KEY=
VAANI_API_BASE=https://api.vaanivoice.ai
# Filled in by `npm run agent:sync` the first time it creates the agent.
VAANI_AGENT_ID=
# Any long random string. The webhook URL registered in Vaani is
#   https://<your-app>.vercel.app/api/vaani/webhook?token=<VAANI_WEBHOOK_TOKEN>
VAANI_WEBHOOK_TOKEN=
# ₹ per minute from Vaani's billing page. Used only when Vaani's call-history API can't return a call's cost.
VAANI_INR_PER_MIN=5.6
# Only if Vaani shows you a signing secret for webhooks (X-Vaani-Signature).
VAANI_WEBHOOK_SECRET=

# ---- Verdict model (Gemini) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# USD per million tokens, copied from Google's pricing page for GEMINI_MODEL. Used for cost-per-call.
GEMINI_USD_PER_M_INPUT=
GEMINI_USD_PER_M_OUTPUT=
USD_INR=88

# ---- Telegram ----
# @BotFather > /newbot
TELEGRAM_BOT_TOKEN=
# Designers group chat id (negative number). `npm run telegram:setup` prints it after you message the group.
TELEGRAM_DESIGNERS_CHAT_ID=
# Nikhil's chat (or a "Founder alerts" group): complaints, SLA breaches, health alerts.
TELEGRAM_FOUNDER_CHAT_ID=
# Any long random string; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# ---- HubSpot ----
# Settings > Integrations > Private Apps. Scopes: crm.objects.contacts.read/write, crm.objects.deals.read/write, crm.schemas.deals.read/write
HUBSPOT_TOKEN=

# ---- Resend ----
RESEND_API_KEY=
# Until a domain is verified, Resend only delivers to your own account address.
RESEND_FROM="Aangan Studio <onboarding@resend.dev>"
# Where the record copy of every handoff note goes.
STUDIO_EMAIL=

# ---- App ----
# Public URL of the deployed dashboard, used for links in Telegram/email.
APP_URL=
# Protects /api/cron/tick (Vercel sends it as a Bearer token).
CRON_SECRET=
# Cal.com consultation booking link sent to the caller once a designer claims the lead.
CAL_BOOKING_URL=
